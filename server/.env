# Development values for the variables named in deploy/local/lab.yaml. Nx loads this file for
# every `server` task. Placeholders only, checked in: real keys and personal overrides go into
# the git-ignored .env.local next to it, which wins over this file.
LAB_ADMIN_PASSWORD=dev
LAB_CODE=DEV1
MBOT1_PASSWORD=dev
MBOT2_PASSWORD=dev
MBOT3_PASSWORD=dev
