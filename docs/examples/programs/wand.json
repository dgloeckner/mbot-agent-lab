{
  "program": {
    "name": "wand_ausweichen",
    "description": "Schaut fünfmal nach vorn: kommt eine Wand, biegt er nach links ab, sonst fährt er 20 cm weiter.",
    "body": [
      {"id": "w_repeat", "type": "repeat", "times": 5, "body": [
        {"id": "w_if", "type": "if",
         "cond": {"id": "w_near", "source": "sensor", "field": "distance_cm", "op": "lt", "value": 25},
         "body": [
          {"id": "w_turn", "type": "call", "tool": "turn", "args": {"degrees": -90}}
         ],
         "else": [
          {"id": "w_drive", "type": "call", "tool": "drive", "args": {"cm": 20}}
         ]}
      ]}
    ]
  }
}
