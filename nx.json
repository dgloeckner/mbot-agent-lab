{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "protocol": [
      "{workspaceRoot}/docs/examples/protocol/**/*"
    ]
  },
  "targetDefaults": {
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "protocol"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "build": {
      "cache": true,
      "inputs": [
        "default"
      ]
    }
  },
  "defaultBase": "main",
  "analytics": false
}