{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "sim",
  "projectType": "application",
  "implicitDependencies": [
    "robot"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "protocol",
        "{workspaceRoot}/robot/src/**/*",
        "{workspaceRoot}/robot/tools/**/*",
        "{workspaceRoot}/docs/lab/feld/**/*"
      ],
      "options": {
        "command": "python3 -m unittest discover -s sim/tests -t sim/tests"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "server"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "{workspaceRoot}/robot/src/**/*",
        "{workspaceRoot}/robot/tools/**/*",
        "{workspaceRoot}/deploy/local/lab.yaml",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ],
      "options": {
        "command": "python3 -m unittest discover -v -s sim/e2e -t sim/e2e"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "python3 sim/run.py --trace 2"
      }
    },
    "grid": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 sim/grid.py"
      }
    }
  }
}
