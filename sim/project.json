{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "sim",
  "projectType": "application",
  "implicitDependencies": ["robot"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "protocol",
        "{workspaceRoot}/robot/src/**/*",
        "{workspaceRoot}/robot/tools/**/*"
      ],
      "options": {
        "command": "python3 -m unittest discover -s sim/tests -t sim/tests"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "python3 sim/run.py --trace 2"
      }
    }
  }
}
